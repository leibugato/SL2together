<view class="page-shell admin-page">
  <view wx:if="{{!cloudConfigured}}" class="empty-state surface">
    尚未配置云开发环境，无法使用数据管理。
  </view>

  <view wx:elif="{{checking}}" class="loading-state">正在检查管理权限...</view>

  <view wx:elif="{{errorMessage}}" class="error-state surface">
    <view>{{errorMessage}}</view>
    <button class="text-button" bindtap="bootstrap">重新检查</button>
  </view>

  <view wx:elif="{{!identity || !identity.isAdmin}}" class="empty-state surface">
    当前微信账号没有管理权限。请先在云开发控制台的 `admins` 集合中添加授权记录。
  </view>

  <block wx:else>
    <view class="admin-header">
      <view>
        <view class="page-title">用户数据</view>
        <view class="page-subtitle">按条件筛选，选择需要导出的设计记录</view>
      </view>
      <text class="role-badge">{{identity.role}}</text>
    </view>

    <scroll-view class="type-filter" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="filter-row">
        <button
          wx:for="{{typeOptions}}"
          wx:key="value"
          class="filter-chip {{typeIndex === index ? 'filter-chip-active' : ''}}"
          data-index="{{index}}"
          bindtap="selectType"
        >
          {{item.label}}
        </button>
      </view>
    </scroll-view>

    <picker
      mode="selector"
      range="{{statusOptions}}"
      range-key="label"
      value="{{statusIndex}}"
      bindchange="onStatusChange"
    >
      <view class="picker-field status-picker">{{statusOptions[statusIndex].label}}</view>
    </picker>

    <view class="user-search">
      <input
        class="text-input user-search-input"
        value="{{userRefInput}}"
        placeholder="按用户引用 ownerRef 筛选，可留空"
        bindinput="onUserRefInput"
        confirm-type="search"
        bindconfirm="searchUser"
      />
      <button class="secondary-button user-search-button" bindtap="searchUser">筛选</button>
    </view>

    <view class="export-actions">
      <button
        class="secondary-button"
        disabled="{{!identity.canExport || exporting}}"
        bindtap="exportFiltered"
      >
        导出当前筛选
      </button>
      <button
        class="primary-button"
        disabled="{{!identity.canExport || exporting || !selectedIds.length}}"
        bindtap="exportSelected"
      >
        {{exporting ? '生成中...' : exportSelectedLabel}}
      </button>
    </view>

    <view wx:if="{{loading}}" class="loading-state">正在加载数据...</view>

    <view wx:elif="{{!items.length}}" class="empty-state surface">
      当前筛选条件下没有记录。
    </view>

    <checkbox-group wx:else class="admin-list" bindchange="onSelectionChange">
      <label wx:for="{{items}}" wx:key="_id" class="admin-row surface">
        <checkbox value="{{item._id}}" checked="{{item.selected}}" color="#A63D2F"></checkbox>
        <view class="admin-row-main">
          <view class="admin-row-top">
            <text class="type-pill">{{item.typeLabel}}</text>
            <text class="status-pill status-{{item.status}}">{{item.statusLabel}}</text>
            <text class="status-pill status-{{item.evaluationStatus}}">{{item.evaluationStatusLabel}}</text>
          </view>
          <view class="admin-name">{{item.name}}</view>
          <view class="admin-meta">用户 {{item.ownerLabel}} · 引用 {{item.ownerRef || '--'}}</view>
          <view class="admin-meta">版本 v{{item.contentVersion}} · {{item.updatedAtLabel}}</view>
        </view>
      </label>
    </checkbox-group>
  </block>
</view>
