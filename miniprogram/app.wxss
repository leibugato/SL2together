page {
  min-height: 100%;
  background: #ece4d8;
  color: #252a27;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.page-stage {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

.page-shell {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  padding: 28rpx 28rpx 56rpx;
  background: rgba(248, 244, 236, 0.62);
}

.page-wallpaper {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  width: 100%;
  height: 100vh;
  pointer-events: none;
}

.page-title {
  margin: 8rpx 0 12rpx;
  color: #1f2522;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.page-subtitle {
  color: #6d716d;
  font-size: 26rpx;
  line-height: 1.6;
}

.surface {
  background: rgba(255, 252, 246, 0.92);
  border: 1rpx solid rgba(207, 198, 183, 0.82);
  border-radius: 20rpx;
  box-shadow: 0 12rpx 30rpx rgba(67, 53, 41, 0.08);
}

.section {
  margin-top: 32rpx;
}

.section-title {
  margin-bottom: 18rpx;
  color: #303633;
  font-size: 30rpx;
  font-weight: 700;
}

.muted {
  color: #777b77;
}

.primary-button,
.secondary-button,
.danger-button,
.text-button {
  min-height: 88rpx;
  border-radius: 18rpx;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 88rpx;
  text-align: center;
}

.primary-button {
  background: #ad4334;
  color: #fffaf3;
  box-shadow: 0 10rpx 22rpx rgba(166, 61, 47, 0.2);
}

.secondary-button {
  background: rgba(255, 252, 246, 0.94);
  border: 1rpx solid rgba(194, 184, 169, 0.9);
  color: #303633;
  box-shadow: 0 6rpx 16rpx rgba(67, 53, 41, 0.06);
}

.danger-button {
  background: #fff7f3;
  border: 1rpx solid #d9a79e;
  color: #a63d2f;
}

.text-button {
  background: transparent;
  color: #256b65;
  line-height: 72rpx;
}

.button-row {
  display: flex;
  gap: 16rpx;
}

.button-row button {
  flex: 1;
}

.status-pill,
.type-pill,
.difficulty-pill {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.status-DRAFT {
  background: #ece8df;
  color: #636660;
}

.status-SUBMITTED,
.status-QUEUED,
.status-RUNNING {
  background: #e6f0ee;
  color: #256b65;
}

.status-RETRYING {
  background: #f7edcf;
  color: #8b641d;
}

.status-NOT_EVALUATED {
  background: #ece8df;
  color: #636660;
}

.status-SUCCEEDED {
  background: #e8efe4;
  color: #426b3f;
}

.status-FAILED {
  background: #f8e6e1;
  color: #a63d2f;
}

.type-pill {
  background: #f2eadc;
  color: #74512d;
}

.difficulty-SIMPLE {
  background: #e5f0e4;
  color: #397040;
}

.difficulty-MEDIUM {
  background: #f7edcf;
  color: #8b641d;
}

.difficulty-HARD {
  background: #f7e1d4;
  color: #a34c28;
}

.difficulty-EXTREME {
  background: #f3dfe0;
  color: #963b48;
}

.empty-state,
.error-state {
  padding: 60rpx 32rpx;
  color: #777b77;
  text-align: center;
  line-height: 1.7;
}

.loading-state {
  padding: 80rpx 0;
  color: #777b77;
  text-align: center;
}

.form-field {
  margin-top: 26rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #343936;
  font-size: 27rpx;
  font-weight: 650;
}

.required {
  color: #a63d2f;
}

.text-input,
.text-area,
.picker-field {
  width: 100%;
  background: rgba(255, 252, 246, 0.94);
  border: 1rpx solid rgba(198, 188, 172, 0.9);
  border-radius: 16rpx;
  color: #252a27;
  font-size: 28rpx;
  box-shadow: 0 6rpx 16rpx rgba(67, 53, 41, 0.05);
}

.text-input,
.picker-field {
  height: 88rpx;
  padding: 0 22rpx;
  line-height: 88rpx;
}

.text-area {
  min-height: 330rpx;
  padding: 20rpx 22rpx;
  line-height: 1.65;
}

.field-help {
  display: block;
  margin-top: 10rpx;
  color: #858984;
  font-size: 22rpx;
  line-height: 1.5;
}

.bottom-safe {
  height: calc(40rpx + env(safe-area-inset-bottom));
}

.evaluation-loading-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(31, 35, 32, 0.42);
}

.evaluation-loading-card {
  width: 100%;
  max-width: 560rpx;
  padding: 26rpx 28rpx 34rpx;
  background: rgba(255, 252, 246, 0.97);
  border: 1rpx solid rgba(220, 211, 197, 0.95);
  border-radius: 28rpx;
  box-shadow: 0 24rpx 60rpx rgba(31, 35, 32, 0.22);
  text-align: center;
}

.evaluation-loading-image {
  display: block;
  width: 330rpx;
  height: 330rpx;
  margin: 0 auto;
  animation: evaluation-float 1.7s ease-in-out infinite;
}

.evaluation-loading-title {
  margin-top: 4rpx;
  color: #303633;
  font-size: 31rpx;
  font-weight: 700;
}

.evaluation-loading-copy {
  margin-top: 10rpx;
  color: #77716a;
  font-size: 23rpx;
  line-height: 1.55;
}

@keyframes evaluation-float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}
