page {
  min-height: 100%;
  background: #f3efe7;
  color: #252a27;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding: 28rpx 28rpx 56rpx;
}

.page-title {
  margin: 8rpx 0 12rpx;
  color: #1f2522;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.page-subtitle {
  color: #6d716d;
  font-size: 26rpx;
  line-height: 1.6;
}

.surface {
  background: #fffcf6;
  border: 1rpx solid #ded8cc;
  border-radius: 14rpx;
}

.section {
  margin-top: 32rpx;
}

.section-title {
  margin-bottom: 18rpx;
  color: #303633;
  font-size: 30rpx;
  font-weight: 700;
}

.muted {
  color: #777b77;
}

.primary-button,
.secondary-button,
.danger-button,
.text-button {
  min-height: 88rpx;
  border-radius: 12rpx;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 88rpx;
  text-align: center;
}

.primary-button {
  background: #a63d2f;
  color: #fffaf3;
}

.secondary-button {
  background: #fffcf6;
  border: 1rpx solid #cfc8bb;
  color: #303633;
}

.danger-button {
  background: #fff7f3;
  border: 1rpx solid #d9a79e;
  color: #a63d2f;
}

.text-button {
  background: transparent;
  color: #256b65;
  line-height: 72rpx;
}

.button-row {
  display: flex;
  gap: 16rpx;
}

.button-row button {
  flex: 1;
}

.status-pill,
.type-pill,
.difficulty-pill {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.status-DRAFT {
  background: #ece8df;
  color: #636660;
}

.status-SUBMITTED,
.status-QUEUED,
.status-RUNNING {
  background: #e6f0ee;
  color: #256b65;
}

.status-RETRYING {
  background: #f7edcf;
  color: #8b641d;
}

.status-NOT_EVALUATED {
  background: #ece8df;
  color: #636660;
}

.status-SUCCEEDED {
  background: #e8efe4;
  color: #426b3f;
}

.status-FAILED {
  background: #f8e6e1;
  color: #a63d2f;
}

.type-pill {
  background: #f2eadc;
  color: #74512d;
}

.difficulty-SIMPLE {
  background: #e5f0e4;
  color: #397040;
}

.difficulty-MEDIUM {
  background: #f7edcf;
  color: #8b641d;
}

.difficulty-HARD {
  background: #f7e1d4;
  color: #a34c28;
}

.difficulty-EXTREME {
  background: #f3dfe0;
  color: #963b48;
}

.empty-state,
.error-state {
  padding: 60rpx 32rpx;
  color: #777b77;
  text-align: center;
  line-height: 1.7;
}

.loading-state {
  padding: 80rpx 0;
  color: #777b77;
  text-align: center;
}

.form-field {
  margin-top: 26rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #343936;
  font-size: 27rpx;
  font-weight: 650;
}

.required {
  color: #a63d2f;
}

.text-input,
.text-area,
.picker-field {
  width: 100%;
  background: #fffcf6;
  border: 1rpx solid #d8d2c6;
  border-radius: 12rpx;
  color: #252a27;
  font-size: 28rpx;
}

.text-input,
.picker-field {
  height: 88rpx;
  padding: 0 22rpx;
  line-height: 88rpx;
}

.text-area {
  min-height: 330rpx;
  padding: 20rpx 22rpx;
  line-height: 1.65;
}

.field-help {
  display: block;
  margin-top: 10rpx;
  color: #858984;
  font-size: 22rpx;
  line-height: 1.5;
}

.bottom-safe {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
